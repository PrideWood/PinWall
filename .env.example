# Server only. Never prefix secrets with VITE_.
# Neon pooled Postgres connection string; use sslmode=verify-full.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=verify-full
APP_URL=http://localhost:5173
# Generate: openssl rand -base64 48
BETTER_AUTH_SECRET=
OWNER_EMAIL=

# Private Neon Object Storage (or another S3-compatible provider).
# Neon: copy the AWS_ENDPOINT_URL_S3 value from Connect > Storage.
# R2 alternative: https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_REGION=ap-southeast-1
S3_BUCKET=whiteboard-images
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
