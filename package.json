{
  "name": "personal-whiteboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx server/dev.ts",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "dev:client": "vite",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:migrate": "node --import tsx --env-file=.env.local scripts/migrate.ts",
    "owner:create": "node --import tsx --env-file=.env.local scripts/owner.ts",
    "check": "tsc -b && tsc -p tsconfig.server.json",
    "storage:cleanup": "node --import tsx --env-file=.env.local scripts/cleanup.ts",
    "test:integration": "node --import tsx scripts/test-integration.ts",
    "storage:check": "node --import tsx --env-file=.env.local scripts/check-storage.ts",
    "phone:pair": "node --import tsx --env-file=.env.local scripts/pair-phone.ts",
    "phone:revoke": "node --import tsx --env-file=.env.local scripts/revoke-phones.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1000.0",
    "@excalidraw/excalidraw": "^0.18.0",
    "better-auth": "~1.7.15",
    "lucide-react": "^1.8.0",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.2",
    "@types/pg": "^8.16.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "nanoid@3": "3.3.20",
    "nanoid@4": "^5.1.16",
    "lodash-es": "^4.18.1"
  }
}
